{
  "title": "OrderEvent",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/definitions/EventMeta"
    },
    "order_intent": {
      "$ref": "#/definitions/OrderIntent"
    },
    "status": {
      "title": "Status",
      "default": "pending",
      "type": "string"
    },
    "broker_order_id": {
      "title": "Broker Order Id",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "order_intent"
  ],
  "definitions": {
    "EventMeta": {
      "title": "EventMeta",
      "type": "object",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string",
          "format": "uuid"
        },
        "saga_id": {
          "title": "Saga Id",
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "default": 1,
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "dedupe_key": {
          "title": "Dedupe Key",
          "type": "string"
        },
        "tags": {
          "title": "Tags",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "saga_id",
        "event_type",
        "source",
        "dedupe_key"
      ]
    },
    "InstrumentId": {
      "title": "InstrumentId",
      "type": "object",
      "properties": {
        "venue": {
          "title": "Venue",
          "default": "NSE",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "sec_type": {
          "title": "Sec Type",
          "default": "EQ",
          "type": "string"
        },
        "expiry": {
          "title": "Expiry",
          "type": "string",
          "format": "date"
        },
        "strike": {
          "title": "Strike",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "default": "INR",
          "type": "string"
        },
        "lot_size": {
          "title": "Lot Size",
          "default": 1,
          "type": "integer"
        },
        "tick_size": {
          "title": "Tick Size",
          "default": 0.05,
          "type": "number"
        }
      },
      "required": [
        "symbol"
      ]
    },
    "TransactionType": {
      "title": "TransactionType",
      "description": "An enumeration.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "type": "string"
    },
    "OrderType": {
      "title": "OrderType",
      "description": "An enumeration.",
      "enum": [
        "MARKET",
        "LIMIT",
        "SL",
        "SL-M"
      ],
      "type": "string"
    },
    "ProductType": {
      "title": "ProductType",
      "description": "An enumeration.",
      "enum": [
        "MIS",
        "CNC",
        "NRML"
      ],
      "type": "string"
    },
    "OrderIntent": {
      "title": "OrderIntent",
      "type": "object",
      "properties": {
        "instrument": {
          "$ref": "#/definitions/InstrumentId"
        },
        "transaction_type": {
          "$ref": "#/definitions/TransactionType"
        },
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "order_type": {
          "$ref": "#/definitions/OrderType"
        },
        "product_type": {
          "$ref": "#/definitions/ProductType"
        },
        "price": {
          "title": "Price",
          "type": "number"
        },
        "trigger_price": {
          "title": "Trigger Price",
          "type": "number"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "instrument",
        "transaction_type",
        "quantity",
        "order_type",
        "product_type"
      ]
    }
  }
}