{
  "title": "RiskEvent",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/definitions/EventMeta"
    },
    "instrument": {
      "$ref": "#/definitions/InstrumentId"
    },
    "signal": {
      "$ref": "#/definitions/SignalEvent"
    },
    "risk_result": {
      "$ref": "#/definitions/RiskResult"
    }
  },
  "required": [
    "meta",
    "instrument",
    "signal",
    "risk_result"
  ],
  "definitions": {
    "EventMeta": {
      "title": "EventMeta",
      "type": "object",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string",
          "format": "uuid"
        },
        "saga_id": {
          "title": "Saga Id",
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "default": 1,
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "dedupe_key": {
          "title": "Dedupe Key",
          "type": "string"
        },
        "tags": {
          "title": "Tags",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "saga_id",
        "event_type",
        "source",
        "dedupe_key"
      ]
    },
    "InstrumentId": {
      "title": "InstrumentId",
      "type": "object",
      "properties": {
        "venue": {
          "title": "Venue",
          "default": "NSE",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "sec_type": {
          "title": "Sec Type",
          "default": "EQ",
          "type": "string"
        },
        "expiry": {
          "title": "Expiry",
          "type": "string",
          "format": "date"
        },
        "strike": {
          "title": "Strike",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "default": "INR",
          "type": "string"
        },
        "lot_size": {
          "title": "Lot Size",
          "default": 1,
          "type": "integer"
        },
        "tick_size": {
          "title": "Tick Size",
          "default": 0.05,
          "type": "number"
        }
      },
      "required": [
        "symbol"
      ]
    },
    "SignalEvent": {
      "title": "SignalEvent",
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/definitions/EventMeta"
        },
        "instrument": {
          "$ref": "#/definitions/InstrumentId"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "minimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        "entry_price": {
          "title": "Entry Price",
          "type": "number"
        },
        "target_price": {
          "title": "Target Price",
          "type": "number"
        },
        "stop_loss_price": {
          "title": "Stop Loss Price",
          "type": "number"
        }
      },
      "required": [
        "meta",
        "instrument",
        "signal",
        "confidence"
      ]
    },
    "RiskResult": {
      "title": "RiskResult",
      "type": "object",
      "properties": {
        "is_approved": {
          "title": "Is Approved",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "max_position_notional": {
          "title": "Max Position Notional",
          "type": "number"
        },
        "max_order_notional": {
          "title": "Max Order Notional",
          "type": "number"
        },
        "stop_loss_price": {
          "title": "Stop Loss Price",
          "type": "number"
        }
      },
      "required": [
        "is_approved",
        "max_position_notional",
        "max_order_notional"
      ]
    }
  }
}