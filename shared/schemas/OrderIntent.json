{
  "title": "OrderIntent",
  "type": "object",
  "properties": {
    "instrument": {
      "$ref": "#/definitions/InstrumentId"
    },
    "transaction_type": {
      "$ref": "#/definitions/TransactionType"
    },
    "quantity": {
      "title": "Quantity",
      "type": "integer"
    },
    "order_type": {
      "$ref": "#/definitions/OrderType"
    },
    "product_type": {
      "$ref": "#/definitions/ProductType"
    },
    "price": {
      "title": "Price",
      "type": "number"
    },
    "trigger_price": {
      "title": "Trigger Price",
      "type": "number"
    },
    "tag": {
      "title": "Tag",
      "type": "string"
    }
  },
  "required": [
    "instrument",
    "transaction_type",
    "quantity",
    "order_type",
    "product_type"
  ],
  "definitions": {
    "InstrumentId": {
      "title": "InstrumentId",
      "type": "object",
      "properties": {
        "venue": {
          "title": "Venue",
          "default": "NSE",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "sec_type": {
          "title": "Sec Type",
          "default": "EQ",
          "type": "string"
        },
        "expiry": {
          "title": "Expiry",
          "type": "string",
          "format": "date"
        },
        "strike": {
          "title": "Strike",
          "type": "number"
        },
        "right": {
          "title": "Right",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "default": "INR",
          "type": "string"
        },
        "lot_size": {
          "title": "Lot Size",
          "default": 1,
          "type": "integer"
        },
        "tick_size": {
          "title": "Tick Size",
          "default": 0.05,
          "type": "number"
        }
      },
      "required": [
        "symbol"
      ]
    },
    "TransactionType": {
      "title": "TransactionType",
      "description": "An enumeration.",
      "enum": [
        "BUY",
        "SELL"
      ],
      "type": "string"
    },
    "OrderType": {
      "title": "OrderType",
      "description": "An enumeration.",
      "enum": [
        "MARKET",
        "LIMIT",
        "SL",
        "SL-M"
      ],
      "type": "string"
    },
    "ProductType": {
      "title": "ProductType",
      "description": "An enumeration.",
      "enum": [
        "MIS",
        "CNC",
        "NRML"
      ],
      "type": "string"
    }
  }
}