    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string",
      "format": "date-time"
    },
    "open": {
      "title": "Open",
      "type": "number"
    },
    "high": {
      "title": "High",
      "type": "number"
    },
    "low": {
      "title": "Low",
      "type": "number"
    },
    "close": {
      "title": "Close",
      "type": "number"
    },
    "volume": {
      "title": "Volume",
      "type": "integer"
    }
