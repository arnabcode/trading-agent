        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "default": 1,
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "dedupe_key": {
          "title": "Dedupe Key",
          "type": "string"
        },
        "tags": {
